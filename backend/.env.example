# ----------------------------------------------------------------------------
# Backend Environment Variables
# Copy this file to .env and adjust values for your environment.
# In production, use a secrets manager (AWS Secrets Manager, Doppler, etc.).
# ----------------------------------------------------------------------------

# ----- Application -----
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=v1
LOG_LEVEL=debug

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ----- Database -----
DATABASE_URL=postgresql://idp:idp_dev_password@localhost:5432/idp?schema=public

# ----- Redis (for BullMQ + rate limiting) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- JWT -----
# In production, generate a strong random secret (e.g. `openssl rand -hex 64`).
JWT_ACCESS_SECRET=change-me-to-a-strong-random-string-min-64-chars-please
JWT_REFRESH_SECRET=change-me-to-another-strong-random-string-min-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- File Upload -----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760
# Allowed mime types (comma-separated)
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ----- Rate Limiting -----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ----- Processing simulation -----
# Time the mock processor sleeps to simulate work, in ms.
PROCESSING_SIMULATED_DELAY_MS=4000

# ----- OCR service -----
# Base URL of the Tesseract OCR microservice. In Docker Compose the worker
# overrides this to http://ocr:4000 (the service name on the compose network).
OCR_SERVICE_URL=http://localhost:4000
OCR_TIMEOUT_MS=120000
