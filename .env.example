# ----------------------------------------------------------------------------
# Compose-level environment variables. Override these to change exposed ports
# or DB credentials without editing docker-compose.yml.
# ----------------------------------------------------------------------------

# Postgres
POSTGRES_USER=idp
POSTGRES_PASSWORD=idp_dev_password
POSTGRES_DB=idp
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Service ports
API_PORT=3001
FRONTEND_PORT=3000
OCR_PORT=4000
